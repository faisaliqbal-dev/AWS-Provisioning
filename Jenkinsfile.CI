pipeline {
    agent any

    environment {
      AWS_ACCESS_KEY_ID = credentials('AWS-Cred')
      AWS_SECRET_KEY_ID = credentials('AWS-Cred')
    }

    stages {
        stage('Initializing Provider') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'AWS-Cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {

                dir ('Terraform'){
                    sh 'terraform init -backend=false'

                }
            }
          }
        }

         stage('Code Format Checks') {
            steps {
                dir ('Terraform'){
                    sh 'terraform fmt'

                }
            }
        }
        
        stage('Code Validate Check') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'AWS-Cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {


                dir ('Terraform'){
                    sh 'terraform validate'

                }
              }
            }
        }
    }
     post {
        always {
            cleanWs()
        }
    }
}
